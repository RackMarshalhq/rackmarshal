[Unit]
Description=RackMarshal read-only MCP server (loopback only)
After=network.target rackmarshal-status.service
Wants=network.target

[Service]
Type=simple
User=rackmarshal
Group=rackmarshal
Environment=RACKMARSHAL_CONFIG=/etc/rackmarshal/rackmarshal.conf
Environment=RACKMARSHAL_STATE_DB=/var/lib/rackmarshal/state.db
ExecStart=/opt/rackmarshal/venv/bin/rackmarshal-mcp
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rackmarshal /var/log/rackmarshal

[Install]
WantedBy=multi-user.target
