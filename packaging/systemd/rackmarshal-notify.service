[Unit]
Description=RackMarshal notification queue pass
After=network.target

[Service]
Type=oneshot
User=rackmarshal
Group=rackmarshal
Environment=RACKMARSHAL_CONFIG=/etc/rackmarshal/rackmarshal.conf
Environment=RACKMARSHAL_STATE_DB=/var/lib/rackmarshal/state.db
ExecStart=/opt/rackmarshal/venv/bin/python -m rackmarshal.notifications.queue --db /var/lib/rackmarshal/state.db
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rackmarshal /var/log/rackmarshal
