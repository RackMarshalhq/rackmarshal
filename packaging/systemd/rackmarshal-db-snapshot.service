[Unit]
Description=RackMarshal state database snapshot
After=local-fs.target

[Service]
Type=oneshot
User=rackmarshal
Group=rackmarshal
Environment=RACKMARSHAL_CONFIG=/etc/rackmarshal/rackmarshal.conf
Environment=RACKMARSHAL_STATE_DB=/var/lib/rackmarshal/state.db
ExecStart=/opt/rackmarshal/venv/bin/python -m rackmarshal.maintenance.snapshot
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rackmarshal
