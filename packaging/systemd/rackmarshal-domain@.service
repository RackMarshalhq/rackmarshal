[Unit]
Description=RackMarshal %i domain cycle
After=network.target

[Service]
Type=oneshot
User=rackmarshal
Group=rackmarshal
RuntimeDirectory=rackmarshal
RuntimeDirectoryMode=0750
Environment=RACKMARSHAL_CONFIG=/etc/rackmarshal/rackmarshal.conf
Environment=RACKMARSHAL_STATE_DB=/var/lib/rackmarshal/state.db
ExecStart=/opt/rackmarshal/venv/bin/python -m rackmarshal.domains.%i.cycle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rackmarshal /var/log/rackmarshal
