[Unit]
Description=RackMarshal evidence export
After=rackmarshal-status.service

[Service]
Type=oneshot
User=rackmarshal
Group=rackmarshal
Environment=RACKMARSHAL_CONFIG=/etc/rackmarshal/rackmarshal.conf
Environment=RACKMARSHAL_STATE_DB=/var/lib/rackmarshal/state.db
ExecStart=/opt/rackmarshal/venv/bin/python -m rackmarshal.evidence.export --retention-class daily --retain-days 35
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rackmarshal
